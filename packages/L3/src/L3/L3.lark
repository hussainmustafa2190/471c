program    : "(" "l3" "(" parameters ")" term ")"
parameters : IDENTIFIER*

term       : let
           | letrec
           | true_term
           | false_term
           | and_term
           | or_term
           | not_term
           | cond_term
           | div_term
           | mod_term
           | lt_term
           | gt_term
           | gte_term
           | lte_term
           | neq_term
           | match_term
           | reference
           | abstract
           | apply
           | immediate
           | primitive
           | branch
           | allocate
           | load
           | store
           | begin
           | tuple_term
           | tuple_ref_term
           | cons_term
           | nil_term
           | car_term
           | cdr_term
           | is_nil_term
           | list_term


let      : "(" "let"    "(" bindings ")" term ")"
letrec   : "(" "letrec" "(" bindings ")" term ")"

bindings : binding*
binding  : "(" IDENTIFIER term ")"


// e.g.  x
reference : IDENTIFIER

// e.g.  (\ (x y) body)  |  (lambda (x y) body)
abstract  : "(" LAMBDA "(" parameters ")" term ")"

// e.g.  (f x y)  or  (loop)
apply     : "(" term term* ")"

// e.g.  42  or  -7
immediate : INTEGER

// e.g.  (+ m n)
primitive : "(" OPERATOR term term ")"

// e.g.  (if (< a b) consequent otherwise)
branch    : "(" "if" "(" COMPARATOR term term ")" term term ")"

// e.g.  (allocate 1)
allocate  : "(" "allocate" INTEGER ")"

// e.g.  (load i 0)
load      : "(" "load" term INTEGER ")"

// e.g.  (store i 0 42)
store     : "(" "store" term INTEGER term ")"

// e.g.  (begin effect1 effect2 value)
begin     : "(" "begin" term+ ")"

// Tuples (TUPLE_REF must lex before TUPLE prefix of "tuple-ref")
tuple_term     : "(" TUPLE term* ")"
tuple_ref_term : "(" TUPLE_REF term INTEGER ")"

// Lists
cons_term   : "(" "cons" term term ")"
nil_term    : NIL
car_term    : "(" "car" term ")"
cdr_term    : "(" "cdr" term ")"
is_nil_term : "(" NULLP term ")"
list_term   : "(" "list" term* ")"

// Booleans and Major 1 sugar (keyword terminals must lex before IDENTIFIER uses)
true_term   : TRUE
false_term  : FALSE
and_term    : "(" AND term term ")"
or_term     : "(" OR term term ")"
not_term    : "(" NOTKW term ")"
cond_term   : "(" COND cond_clauses ")"
cond_clauses: (cond_clause_normal | cond_clause_else)+
cond_clause_normal: "(" term term ")"
cond_clause_else  : "(" ELSE term ")"

div_term    : "(" SLASH term term ")"
mod_term    : "(" PCT term term ")"
lt_term     : "(" LESS term term ")"
gt_term     : "(" GT term term ")"
gte_term    : "(" GTE term term ")"
lte_term    : "(" LTE term term ")"
neq_term    : "(" NEQ term term ")"

// Major 2: pattern matching (tuple-pattern uses PATNAME so "(tuple a b)" is not tuple_term)
match_term   : "(" MATCH term match_clause+ ")"
match_clause : "(" pattern term ")"

pattern            : int_pattern
                   | bool_pattern
                   | nil_pattern
                   | cons_pattern
                   | tuple_pattern
                   | wildcard_pattern
                   | name_pattern
int_pattern        : INTEGER
bool_pattern       : TRUE | FALSE
nil_pattern        : NIL
cons_pattern       : "(" "cons" PATNAME PATNAME ")"
tuple_pattern      : "(" "tuple" PATNAME* ")"
wildcard_pattern   : WILDCARD
name_pattern       : PATNAME


LAMBDA.2    : "\\" | "lambda"
OPERATOR    : "+" | "-" | "*"
COMPARATOR  : LESS | EQEQ
MATCH.2     : "match"
TRUE.2      : "true"
FALSE.2     : "false"
AND.2       : "and"
OR.2        : "or"
NOTKW.2     : "not"
ELSE.2      : "else"
COND.2      : "cond"
SLASH.2     : "/"
PCT.2       : "%"
LESS.2      : "<"
EQEQ.2      : "=="
GTE.3       : ">="
LTE.3       : "<="
NEQ.2       : "!="
GT.2        : ">"
WILDCARD.2  : "_"
PATNAME     : /[a-zA-Z][a-zA-Z0-9_]*/
TUPLE_REF.3 : "tuple-ref"
TUPLE.2     : "tuple"
NIL.2       : "nil"
NULLP.2     : "null?"
IDENTIFIER  : /[a-zA-Z_][a-zA-Z0-9_]*/
INTEGER     : /-?(?:0|[1-9][0-9]*)/


%import common.WS
%ignore WS
%ignore /;[^\n]*/
